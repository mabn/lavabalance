{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lavabalance",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-27",
  "account_id": "9a1829e6502587e153ffa45b76de7ed3",
  // nodejs_compat is not required: the Worker uses only web APIs (and the bot
  // process lives in the container, not in the Worker).

  // The LOS public API (formerly the separate "lavaos" Worker) is served by THIS
  // Worker since the merge; the lavabalance.fogofwar.dev custom domain routes here
  // (the old lavaos.fogofwar.dev name no longer resolves). `custom_domain: true`
  // makes `wrangler deploy` create the DNS record + certificate on the zone. The
  // workers.dev route keeps serving the bot/control-plane UI as before.
  "routes": [{ "pattern": "lavabalance.fogofwar.dev", "custom_domain": true }],
  // Declaring routes turns the workers.dev URL off by default; keep it — the bot
  // UI / control plane has always been served there.
  "workers_dev": true,
  // `wrangler dev` would otherwise hand the Worker request URLs on the first
  // route's host (its "upstream" emulation), so the browser's Origin
  // (localhost) would never match and every login POST would be refused as
  // cross-site. Dev only; deploys ignore it.
  "dev": { "host": "localhost:8787" },

  // Static assets (rank icons). Files under ./public are served at the matching
  // path (e.g. public/ranks/1.png → /ranks/1.png) by the runtime BEFORE the Worker
  // runs; requests that don't match a file fall through to the Worker.
  "assets": { "directory": "./public" },

  // The bot itself: src/bot/bot.ts running in a Cloudflare Container (./Dockerfile),
  // supervised by the BotContainer Durable Object (src/botContainer.ts). One
  // instance: one bot account = one lobby session. `lite` (1/16 vCPU, 256 MiB) is
  // plenty for an idle-most-of-the-time chat bot. Requires the Workers Paid plan
  // and a running Docker daemon at `wrangler deploy` time (it builds + pushes).
  "containers": [
    {
      "class_name": "BotContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite",
      // `npx wrangler containers ssh <instance id>` (ids from `wrangler containers
      // instances <container id>`) opens a shell in the VM around the running
      // instance — Cloudflare runs the SSH server, the image needs no sshd. Access
      // is authenticated ONLY against the keys listed here (ssh-ed25519 is the one
      // supported type); with no matching key the tunnel is refused with
      // "Unexpected server response: 400". Keys reach an instance at start, so
      // after adding one: deploy, then restart the bot (POST /bot/stop + /bot/start).
      // See https://developers.cloudflare.com/containers/guides/ssh/
      "ssh": { "enabled": true },
      "authorized_keys": [
        {
          "name": "admin",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAN+Qg7rSqTdnXFRNEOnSK3VnGtbgFSnsEgWcQ+PBy8P admin"
        }
      ]
    }
  ],

  // Every few minutes the Worker's `scheduled` handler asks the BotContainer to
  // `ensureRunning()`: Cloudflare does not guarantee a container instance keeps
  // running (host restarts, image rollouts), so this restarts the bot after such
  // an event — but only while the persisted intent says it should be running.
  "triggers": { "crons": ["*/5 * * * *"] },

  "durable_objects": {
    "bindings": [
      // The bot supervisor (see "containers" above).
      { "name": "BOT_CONTAINER", "class_name": "BotContainer" },
      // Single Dispatcher instance: receives proxied protocol messages over a
      // WebSocket (the proxy → Dispatcher tap; being retired in favour of the bot).
      { "name": "DISPATCHER", "class_name": "Dispatcher" },
      // Single TeiserverDO instance: holds a logged-in Teiserver web session and
      // scrapes the lobby pages on demand for GET /api/lobbies?src=teiserver.
      { "name": "TEISERVER", "class_name": "TeiserverDO" },
      // Single RatingsDO instance: owns the persistent (SQLite) Lavabar rating
      // cache. All lobby sources resolve player ratings through it, so every
      // Lavabar fetch is isolated on this DO's own subrequest budget instead of
      // the request-serving Worker's.
      { "name": "RATINGS", "class_name": "RatingsDO" },
      // Single LosDO instance: the LOS projection (SQLite) and its single writer —
      // the whole LOS store (src/los/losDO.ts), merged from the former lavaos
      // Worker. NOTE: DO storage did not migrate with the merge — after the first
      // deploy, re-upload the day files (npm run lavaos:upload) to rebuild the fold.
      { "name": "LOS", "class_name": "LosDO" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LavabalanceBot"] },
    { "tag": "v2", "new_sqlite_classes": ["Dispatcher"] },
    // LavabalanceBot stopped being a Durable Object (it became a plain class, then
    // was deleted).
    { "tag": "v3", "deleted_classes": ["LavabalanceBot"] },
    { "tag": "v4", "new_sqlite_classes": ["TeiserverDO"] },
    { "tag": "v5", "new_sqlite_classes": ["RatingsDO"] },
    { "tag": "v6", "new_sqlite_classes": ["LosDO"] },
    // v7 was the short-lived "bot as a DO" PoC (LavaBot, cloudflare:sockets in a
    // Durable Object); v8 replaces it with the container-hosted bot.
    { "tag": "v7", "new_sqlite_classes": ["LavaBot"] },
    { "tag": "v8", "deleted_classes": ["LavaBot"], "new_sqlite_classes": ["BotContainer"] }
  ],

  // Non-secret config. The lobby server is hard-coded in src/config.ts
  // (server4.beyondallreason.info:8200, plaintext). Secrets are set with
  // `wrangler secret put <NAME>` and are NOT committed:
  //   BOT_PASSWORD        the bot account's PLAINTEXT password — the container's
  //                       bot hashes it itself (md5→base64) for the lobby LOGIN and
  //                       uses it as-is for the Teiserver web login
  //   BOT_PASSWORD_HASH   base64(md5(password)) — kept for tools/connect-test
  //   CONTROL_TOKEN       optional bearer token for /battles/*, /admin/*, /bot/*
  //   ACCESS_BOT_CLIENT_ID / ACCESS_BOT_CLIENT_SECRET
  //                       the Access service token the bot sends on /api/bot/*
  //   TEISERVER_PASSWORD  plaintext password for the Worker's own src=teiserver
  //                       web login (TeiserverDO)
  "vars": {
    // SUPERADMIN LOGIN (Cloudflare Access, src/access.ts): admin mode and the
    // admin routes verify the CF_Authorization JWT against these two. Neither
    // is secret: the Zero Trust team domain, and the Audience (AUD) tag of the
    // Access application protecting lavabalance.fogofwar.dev/admin/login.
    // Either empty = nobody is an admin through Access (fail-closed).
    // ADMIN_OPEN=true (every request an admin) belongs in .dev.vars ONLY.
    "ACCESS_TEAM_DOMAIN": "bartools.cloudflareaccess.com",
    "ACCESS_AUD": "f3481bed8be26cc109332a6b65f295a6cd64e8119e9364fc424c901ebc9ef28d",
    // The AUD of the SECOND Access application, fronting /api/bot/* (the bot's
    // .login/.logout calls, src/access.ts botIdentity). Empty = .login is off.
    // Its service token is the ACCESS_BOT_CLIENT_ID / ACCESS_BOT_CLIENT_SECRET
    // secrets, handed to the container.
    "ACCESS_BOT_AUD": "cd6bf83925162b0f20a5b70fb80fe0ab62c8a0bff580e94d7b20435b31857935",
    "ACCESS_SCOUT_AUD": "9bd2367f79befff39c5117cc5ace805f206c83ca81563ab13ef4b04ba9c19d47",
    // The bot account (lobby LOGIN name). Also the container's BOT_LOGIN.
    "BOT_USERNAME": "lavabalance",
    // This becomes the user's `lobby_client` name that Teiserver broadcasts in
    // ADDUSER. Keep it as a plain, identifiable client name.
    // Equivalent of "User-Agent" header.
    "BOT_LOBBY_NAME": "lavabalance",
    // Accounts allowed to whisper admin commands (.join …) to the bot,
    // comma-separated, case-insensitive. Empty = admin commands disabled.
    "BOT_ADMINS": "huk123,Songi,Lucifer_,GODOFWAR09,djarshi",
    // Battle id the bot joins after every login (optional; empty = none).
    "BOT_AUTOJOIN_ROOM": "",
    // Enabled `src` modes for GET /api/lobbies[/:id], comma-separated (see
    // src/config.ts enabledSrcModes). The FIRST entry is the default used when
    // `?src=` is omitted (currently `teiserver`); any known mode not listed here
    // is disabled and its requests get a 400. Known modes: teiserver, proxy, rtsapi.
    "SRC_MODES": "teiserver",
    // Player-rating cache (the RatingsDO, src/rating/ratingsDO.ts), in
    // milliseconds. The cache is persistent (SQLite) and always served; a cached
    // entry last fetched more than this long ago is refreshed in the background
    // on the next lookup.
    "RATING_CACHE_REFRESH_MS": 900000
    // The Teiserver web-login account's email is the TEISERVER_EMAIL secret
    // (`wrangler secret put TEISERVER_EMAIL`), used by the Worker's scraper and
    // handed to the bot container; its password is TEISERVER_PASSWORD (Worker) /
    // BOT_PASSWORD (container).
  },

  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
    // Workers tracing: end-to-end spans for each invocation (fetch, DO RPC,
    // outbound fetch/socket). Still in early beta, so it must be opted into
    // explicitly here — observability.enabled alone only turns on logs.
    // head_sampling_rate defaults to 1 (trace every request).
    "traces": { "enabled": true }
  }
}
