{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src", "test", "worker-configuration.d.ts"],
  // The Node bot entry uses node:* APIs (no @types/node in this project); it runs
  // via tsx. Everything else under src/bot (e.g. teiserverWeb.ts) stays checked —
  // the Worker imports it.
  "exclude": ["src/bot/bot.ts"]
}
