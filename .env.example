BOT_LOGIN=
BOT_PASSWORD=
# Comma-separated account names allowed to whisper commands (.join <battleID>) to the bot
BOT_ADMINS=
# Integer battle id to join automatically after every login (optional)
BOT_AUTOJOIN_ROOM=
# Email for the Teiserver web-API login (the password used is BOT_PASSWORD).
# Empty = skip the web login (no party data for .balance, no idle lobby finder).
BOT_TEISERVER_EMAIL=
# LOS service base URL for the bot's ratings lookup (optional; default
# https://lavabalance.fogofwar.dev — override for local dev / stub tests)
BOT_LAVAOS_URL=
# Control token for the Worker's /api/avoids routes (the .avoid whispers write
# players' avoid lists through them). Must match the Worker's CONTROL_TOKEN;
# empty = the routes are open, which is fine for local dev.
BOT_CONTROL_TOKEN=
